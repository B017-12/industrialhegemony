# Copy to .env (gitignored). Without LLM_MODEL/key the copilot uses the deterministic fallback.
# Gemini via AI Studio: check the current model id at https://aistudio.google.com before setting it.
LLM_MODEL=google:<model-id-from-ai-studio>
GEMINI_API_KEY=
# Backup (OpenAI-compatible, tool calling not yet verified):
# LLM_MODEL=openai-chat:<model>   with OPENAI_BASE_URL=https://api.featherless.ai/v1 and OPENAI_API_KEY=
